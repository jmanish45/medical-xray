# Denoise X — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/denoisex?retryWrites=true&w=majority

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret-string

# Token expiry in minutes (default: 10080 = 7 days)
JWT_EXPIRE_MINUTES=10080
